# ============ RAG 配置 ============
# RAG 模式：固定使用 vector（向量检索）
RAG_MODE=vector
EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5
RERANKER_MODEL_PATH=BAAI/bge-reranker-base

# ============ LLM 配置 ============
# 配置方式：使用外部 API（OpenAI 兼容协议）
LLM_PROTOCOL=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# 说明：填入你的真实 API key 后即可使用

# ============ 服务配置 ============
API_HOST=0.0.0.0
API_PORT=8802
LOG_LEVEL=INFO

# ============ 数据库配置 ============
DB_PATH=data/platform.db

# ============ 知识库配置 ============
KNOWLEDGE_BASE_PATH=data/knowledge

# ============ 管理后台配置 ============
# ⚠️ ADMIN_PASSWORD 是全站 API 鉴权口令(前端登录 token / Authorization: Bearer <值>)。
#    生产环境必须改成强密码! 默认 admin123 仅本地开发, 留默认启动时会 logger.warning。
DEFAULT_TOKEN=change-me-token
ADMIN_PASSWORD=admin123
LISTING_PLATFORM=goofish
